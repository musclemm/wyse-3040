# 1. 目标平台与镜像设置（适配 Wyse 3040 UEFI + 8GB eMMC）
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# CONFIG_ISO_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set

# 2. Wyse 3040 硬件驱动与调度优化
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci=y
CONFIG_PACKAGE_kmod-sdhci-pci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_resize2fs=y

# 3. 基础 LuCI 与 Argon 主题
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# 4. 四大目标插件（OpenClash + PassWall + SSRP + AdGuardHome）
# --- OpenClash ---
CONFIG_PACKAGE_luci-app-openclash=y

# --- PassWall ---
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Sing-Box=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y

# --- AdGuardHome ---
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
